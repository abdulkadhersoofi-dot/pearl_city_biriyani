# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-value
# Optional: key for the encrypted e-invoice / e-way bill logins (Phase 8).
# Unset = derived from SECRET_KEY. Changing either makes saved logins unreadable
# (clients re-enter them under e-Invoice settings).
# EINVOICE_SECRET_KEY=another-long-random-value

# Database
DATABASE_URL=postgresql+psycopg2://gst_app:change-me@localhost:5432/gst_billing

# Redis (server-side sessions)
REDIS_URL=redis://localhost:6379/0

# Firm identity (Super Admin / platform owner)
FIRM_NAME=ARFA
