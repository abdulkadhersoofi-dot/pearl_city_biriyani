# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-value

# Database
DATABASE_URL=postgresql+psycopg2://gst_app:change-me@localhost:5432/gst_billing

# Redis (server-side sessions)
REDIS_URL=redis://localhost:6379/0

# OTP / password reset
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Email (used to deliver OTPs; console backend used automatically when unset)
# MAIL_BACKEND: console (logs to stdout) | resend (HTTPS API - use this on
# hosts that block outbound SMTP, e.g. Render's free tier) | smtp
MAIL_BACKEND=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Firm identity (Super Admin / platform owner)
FIRM_NAME=Pearl City & Associates
