<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ArfaScan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/arfa_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bubble</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/arfa_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/header_dark</item>
        <item name="android:navigationBarColor">@color/chat_bg</item>
        <item name="android:windowBackground">@color/chat_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Dark buttons on the light bar by day, light ones by night (API 27+). -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_bars</item>
    </style>

    <style name="Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipSurfaceColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
