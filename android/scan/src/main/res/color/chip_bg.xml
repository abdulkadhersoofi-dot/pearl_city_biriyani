<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque on purpose: a see-through colour shows the chip's white surface
     through it, which hid the white labels (unchecked chips looked blank). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/white" android:state_checked="true" />
    <item android:color="@color/chip_idle" />
</selector>
