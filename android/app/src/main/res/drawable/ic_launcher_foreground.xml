            android:fillColor="#CFE5D6"
            android:pathData="M36,31h24a2,2 0,0 1,0 4h-24a2,2 0,0 1,0 -4z" />
        <path
            android:fillColor="#CFE5D6"
            android:pathData="M36,40h14a2,2 0,0 1,0 4h-14a2,2 0,0 1,0 -4z" />
