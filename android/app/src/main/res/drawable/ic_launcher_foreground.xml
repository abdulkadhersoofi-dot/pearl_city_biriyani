    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateX="13.2"
        android:translateY="11.5">
        <!-- The receipt, torn edge at the bottom. -->
        <path
            android:fillColor="#FFFDF7"
            android:pathData="M28,20h40a4,4 0,0 1,4 4v52l-6,-4 -6,4 -6,-4 -6,4 -6,-4 -6,4 -6,-4 -6,4V24a4,4 0,0 1,4 -4z" />
