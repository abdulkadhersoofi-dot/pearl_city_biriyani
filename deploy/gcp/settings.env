# Google Cloud settings for ARFA - no secrets here (those are in Secret
# Manager). Read by scripts/gcp/*.sh and by Cloud Build (cloudbuild.yaml).
# Change a value, commit, push: the next deploy uses it.

PROJECT_ID="${PROJECT_ID:-arfa-gst-prod-1}"
REGION="asia-south1"                       # Mumbai
REPO="arfa"                                # Artifact Registry (images)

# --- database ------------------------------------------------------------
SQL_INSTANCE="arfa-db"
SQL_VERSION="POSTGRES_18"                 # the same major version as Render
SQL_TIER="db-custom-1-3840"                # 1 vCPU, 3.75 GB. Next: db-custom-2-7680.
SQL_STORAGE_GB="50"                        # grows by itself when nearly full
# Set explicitly, not left to the tier's default, so the connection budget
# below rests on a known number. setup.sh reads it back (SHOW
# max_connections) before deriving MAX_INSTANCES.
SQL_MAX_CONNECTIONS="150"
DB_NAME="arfa"
STAGING_DB_NAME="arfa_staging"

# --- the app on Cloud Run ---------------------------------------------------
SERVICE="arfa-web"
STAGING_SERVICE="arfa-web-staging"
CPU="2"
MEMORY="2Gi"
WORKERS="2"                                # gunicorn processes per instance
THREADS="4"                                # requests per process at once
CONCURRENCY="8"                            # = WORKERS x THREADS: nothing queues inside
POOL_SIZE="4"                              # = THREADS: one connection per busy thread
MAX_OVERFLOW="1"
MIN_INSTANCES="2"                          # two warm, so the morning rush never waits
# Connections: each instance holds at most WORKERS x (POOL_SIZE +
# MAX_OVERFLOW) = 10. MAX_INSTANCES = (80% of max_connections - RESERVED)
# / 10, worked out by `scripts/gcp/setup.sh connections` from the live
# server. With 150: (120 - 30) / 10 = 9 instances = 72 requests at once.
# RESERVED: staging (2 x 10), jobs and your own queries (10).
RESERVED_CONNECTIONS="30"
MAX_INSTANCES="9"
STAGING_MAX_INSTANCES="2"

# Production is deployed only once its data is in (the cutover,
# docs/cloud-cutover.md). Until then a push deploys staging only.
PRODUCTION_ENABLED="0"

# --- addresses ---------------------------------------------------------------
PUBLIC_URL="https://arfa.live"
# Proxies in front of the app: Firebase Hosting, then Cloud Run's own front
# end. Checked on staging with LOG_FORWARDED_FOR=1 (docs/cloud-setup.md).
PROXY_FIX_X_FOR="2"
